#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

show_help() {
    cat << EOF
Usage: ./run <command>

Commands:
  deps    Install Lua 5.4 + luarocks (via Homebrew) and busted (into .luarocks/)
  test    Run busted tests
  help    Show this help message

EOF
}

case "${1:-help}" in
    deps)
        brew install lua@5.4 luarocks
        luarocks --lua-version 5.4 --lua-dir "$(brew --prefix lua@5.4)" install --tree=.luarocks busted
        ;;
    test)
        .luarocks/bin/busted
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
