#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

LUA_PREFIX="/opt/homebrew/opt/lua@5.4"

show_help() {
    cat << EOF
Usage: ./run <command>

Commands:
  deps    Install Lua 5.4 + luarocks (via Homebrew) and busted (into .luarocks/)
  test    Run busted tests
  help    Show this help message

EOF
}

ensure_brew_pkg() {
    local pkg="$1"
    if ! brew list "$pkg" >/dev/null 2>&1; then
        brew install "$pkg"
    fi
}

case "${1:-help}" in
    deps)
        ensure_brew_pkg lua@5.4
        ensure_brew_pkg luarocks
        luarocks --lua-version 5.4 --lua-dir "$LUA_PREFIX" \
            install --tree=.luarocks busted
        ;;
    test)
        if [ ! -x .luarocks/bin/busted ]; then
            echo "busted not found — run './run deps' first" >&2
            exit 1
        fi
        .luarocks/bin/busted
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1" >&2
        show_help
        exit 1
        ;;
esac
